# --- Postgres ---
POSTGRES_USER=seo_admin
POSTGRES_PASSWORD=seo_password
POSTGRES_DB=seo_crawler
DATABASE_URL=postgresql://seo_admin:seo_password@localhost:5432/seo_crawler

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200

# --- App ---
NEXT_PUBLIC_APP_NAME="Advanced SEO Intelligence & Technical Crawler"
API_PORT=4000
WEB_PORT=3000
CRAWLER_CONCURRENCY=5
CRAWLER_USER_AGENT="SEOIntelBot/1.0 (+https://example.com/bot)"

# --- AWS (optional, for storage/deploy) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
